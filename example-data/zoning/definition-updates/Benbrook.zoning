{
  "type": "FeatureCollection",
  "version": "0.5.0",
  "muni_name": "Benbrook",
  "date": "2025-11-18",
  "source": "https://library.municode.com/tx/benbrook/codes/code_of_ordinances?nodeId=CD_ORD_TIT17ZO",
  "definitions": {
    "height": [
      {
        "condition": "roof_type == 'flat'",
        "expression": "height_top"
      },
      {
        "condition": "roof_type == 'hip'",
        "expression": "0.5 * (height_top + height_eave)"
      },
      {
        "condition": "roof_type == 'mansard'",
        "expression": "height_deck"
      },
      {
        "condition": "roof_type == 'gable'",
        "expression": "0.5 * (height_top + height_eave)"
      }
    ],
    "res_type": [
      {
        "condition": "total_units == 1",
        "expression": "'one_family'"
      },
      {
        "condition": [
          "total_units > 1",
          "sep_platting == TRUE",
          "unit_separation == 'party_wall'"
        ],
        "expression": "'townhouse'"
      },
      {
        "condition": "total_units == 2",
        "expression": "'two_family'"
      },
      {
        "condition": "total_units == 3",
        "expression": "'three_family'"
      },
      {
        "condition": "total_units > 3",
        "expression": "'multifamily'"
      }
    ]
  },
